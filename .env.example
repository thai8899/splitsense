# ---------------------------------------------------------------
# SplitSense environment. Copy to .env and fill in the blanks:
#   cp .env.example .env
# ---------------------------------------------------------------

# --- App -------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public URL people open. Used to build payment links.
# Local dev: the Vite URL. Production: your Render URL, e.g. https://splitsense.onrender.com
APP_BASE_URL=http://localhost:5173
# Any random string of 16+ characters. Used to hash host admin tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# --- PayPal (developer.paypal.com > Apps & Credentials > Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID shown after you add a webhook to your sandbox app (see README).
PAYPAL_WEBHOOK_ID=
# Local testing with the PayPal webhook simulator only. Refused when NODE_ENV=production.
PAYPAL_WEBHOOK_SKIP_VERIFY=false
# Shown to buyers on the PayPal review page.
PAYPAL_BRAND_NAME=SplitSense

# --- AI --------------------------------------------------------
# anthropic = Claude (console.anthropic.com > API keys, needs prepaid credits)
# gemini    = Google Gemini (aistudio.google.com > Get API key, has a free tier)
AI_PROVIDER=anthropic
AI_API_KEY=
# Leave empty for the default: claude-sonnet-5-5 (anthropic) or gemini-3.5-flash (gemini)
AI_MODEL=
# How many times the agent may self-correct after a failed validation.
AI_MAX_RETRIES=2

# --- Storage ---------------------------------------------------
# SQLite file. Created automatically. Relative paths resolve from the server/ folder.
DATABASE_PATH=./data/splitsense.db

# --- Limits ----------------------------------------------------
DEFAULT_CURRENCY=USD
MAX_UPLOAD_MB=8
